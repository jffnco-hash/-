{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sukuna-bot9",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "define": {
    "globalThis.process.getBuiltinModule": "undefined"
  },
  "find_additional_modules": true,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "node_modules/@oxidezap/whatsapp-rust-bridge/dist/whatsapp_rust_bridge_bg.wasm",
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT",
        "class_name": "SukunaBot"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SukunaBot"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
